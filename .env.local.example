# URL pública del sitio (para JSON-LD y sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://altamar-demo.vercel.app

# Data Cloud Web SDK: URL del script que da el conector web de Data Cloud
# (Data Cloud → Websites & Mobile Apps → tu conector → Integration Guide)
NEXT_PUBLIC_DATACLOUD_SITEMAP_URL=https://cdn.c360a.salesforce.com/beacon/c360a/<CONNECTOR_ID>/scripts/c360a.min.js

# Marketing Cloud Next: registro con doble opt-in (solo servidor)
# Form Handler → Code Snippet → Server-side → "action" del <form>
MC_FORM_HANDLER_URL=https://<tu-sitio>.my.site.com/lp/cms/form/submit/v1/<FORM_ID>
# Segundo Form Handler: confirmación del doble opt-in desde /registro/confirmado
MC_CONFIRM_FORM_HANDLER_URL=https://<tu-sitio>.my.site.com/lp/cms/form/submit/v1/<FORM_ID>
