# URL pública del sitio (para JSON-LD y sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://altamar-demo.vercel.app

# Data Cloud Web SDK: URL del script que da el conector web de Data Cloud
# (Data Cloud → Websites & Mobile Apps → tu conector → Integration Guide)
NEXT_PUBLIC_DATACLOUD_SITEMAP_URL=https://cdn.c360a.salesforce.com/beacon/c360a/<CONNECTOR_ID>/scripts/c360a.min.js

# Marketing Cloud Next: registro con doble opt-in (solo servidor, nunca NEXT_PUBLIC_)
# External Client App con OAuth Client Credentials Flow habilitado y un usuario de integración como "Run As"
SF_MY_DOMAIN=<tu-subdominio>.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# URL completa de envío del Form Handler (Marketing → Form Handlers → detalle del handler / guía "Integrate Form Submissions")
MC_FORM_HANDLER_URL=
